@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h1 class="display-6 fw-bold text-success">Test Case Management</h1>
                        <p class="text-muted fs-5">Tạo tài khoản mới để bắt đầu</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" aria-required="true" />
                            <label asp-for="Input.Email">
                                <i class="bi bi-envelope me-2"></i>Email
                            </label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="new-password" aria-required="true" />
                            <label asp-for="Input.Password">
                                <i class="bi bi-lock me-2"></i>Mật Khẩu
                            </label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                Mật khẩu phải có ít nhất 6 ký tự, bao gồm chữ cái, số và ký tự đặc biệt.
                            </small>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" aria-required="true" />
                            <label asp-for="Input.ConfirmPassword">
                                <i class="bi bi-lock-fill me-2"></i>Xác Nhận Mật Khẩu
                            </label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="btn btn-success btn-lg w-100 mb-4 rounded-3 shadow-sm">
                            <i class="bi bi-person-plus-fill me-2"></i>Đăng Ký Tài Khoản
                        </button>

                        <div class="text-center">
                            <p class="text-muted mb-2">Đã có tài khoản?</p>
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-primary w-100 rounded-3">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập Ngay
                            </a>
                        </div>
                    </form>

                    <!-- External Registration -->
                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <div class="mt-5 pt-4 border-top">
                                <p class="text-center text-muted mb-4">Hoặc đăng ký bằng</p>
                                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                    <div class="d-grid gap-3">
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit" class="btn btn-outline-dark btn-lg rounded-3" name="provider" value="@provider.Name">
                                                @if (provider.Name.Contains("Google"))
                                                {
                                                    <i class="bi bi-google me-2"></i>
                                                }
                                                else if (provider.Name.Contains("Facebook"))
                                                {
                                                    <i class="bi bi-facebook me-2"></i>
                                                }
                                                else if (provider.Name.Contains("Microsoft"))
                                                {
                                                    <i class="bi bi-microsoft me-2"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-globe me-2"></i>
                                                }
                                                Đăng ký với @provider.DisplayName
                                            </button>
                                        }
                                    </div>
                                </form>
                            </div>
                        }
                    }

                    <div class="text-center mt-5 pt-4 border-top">
                        <small class="text-muted">
                            © 2025 Test Case Management System
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}