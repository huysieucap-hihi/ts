@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng Nhập / Đăng Ký";
    Layout = null; // Tắt layout mặc định để dùng CSS riêng
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true">
</head>
<body>

    <div class="container">

        <div class="form-box login">
            <form id="account" method="post">
                <h1>Đăng Nhập</h1>

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="text-align:center; margin-bottom:10px;"></div>

                <div class="input-box">
                    <input asp-for="Input.Email" type="email" placeholder="Email" required>
                    <i class='bx bxs-user'></i>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="input-box">
                    <input asp-for="Input.Password" type="password" placeholder="Mật khẩu" required>
                    <i class='bx bxs-lock-alt'></i>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="forgot-link">
                    <a asp-page="./ForgotPassword">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn">Đăng Nhập</button>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <p>hoặc đăng nhập bằng</p>
                    <div class="social-icons">
                        @* Form phụ để xử lý nút bấm Social *@
                        <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" style="width:auto;">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" name="provider" value="@provider.Name" title="Đăng nhập bằng @provider.DisplayName">
                                    @if (provider.Name == "Google")
                                    {
                                        <i class='bx bxl-google'></i>
                                    }
                                    else if (provider.Name == "Facebook")
                                    {

                                        <i class='bx bxl-facebook'></i>
                                    }
                                    else
                                    {

                                        <i class='bx bxl-globe'></i>
                                    }
                                </button>
                            }
                        </form>
                    </div>
                }
            </form>
        </div>

        <div class="form-box register">
            <form asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <h1>Đăng Ký</h1>

                <div class="input-box">
                    <input name="Input.Email" type="email" placeholder="Email" required>
                    <i class='bx bxs-envelope'></i>
                </div>

                <div class="input-box">
                    <input name="Input.Password" type="password" placeholder="Mật khẩu" required>
                    <i class='bx bxs-lock-alt'></i>
                </div>

                <div class="input-box">
                    <input name="Input.ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu" required>
                    <i class='bx bxs-lock-alt'></i>
                </div>

                <button type="submit" class="btn">Đăng Ký</button>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <p>hoặc đăng ký bằng</p>
                    <div class="social-icons">
                        <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" style="width:auto;">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" name="provider" value="@provider.Name">
                                    @if (provider.Name == "Google")
                                    {
                                        <i class='bx bxl-google'></i>
                                    }
                                    else if (provider.Name == "Facebook")
                                    {

                                        <i class='bx bxl-facebook'></i>
                                    }
                                    else
                                    {

                                        <i class='bx bxl-globe'></i>
                                    }
                                </button>
                            }
                        </form>
                    </div>
                }
            </form>
        </div>

        <div class="toggle-box">
            <div class="toggle-panel toggle-left">
                <h1>Xin chào!</h1>
                <p>Bạn chưa có tài khoản?</p>
                <button class="btn register-btn">Đăng Ký Ngay</button>
            </div>
            <div class="toggle-panel toggle-right">
                <h1>Chào mừng trở lại!</h1>
                <p>Bạn đã có tài khoản?</p>
                <button class="btn login-btn">Đăng Nhập</button>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>