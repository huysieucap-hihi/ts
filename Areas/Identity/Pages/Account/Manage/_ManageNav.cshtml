@using WebsiteQL_Testcase.Areas.Identity.Pages.Account.Manage

<nav class="manage-nav">
    <a asp-page="./Index"
       class="manage-link @(ViewData["ActivePage"]?.ToString() == ManageNavPages.Index ? "active" : "")">
        👤 Quản lý thông tin
    </a>

    <a asp-page="./Email"
       class="manage-link @(ViewData["ActivePage"]?.ToString() == ManageNavPages.Email ? "active" : "")">
        📧 Email
    </a>

    <a asp-page="./ChangePassword"
       class="manage-link @(ViewData["ActivePage"]?.ToString() == ManageNavPages.ChangePassword ? "active" : "")">
        🔑 Đổi mật khẩu
    </a>

    <a asp-page="./TwoFactorAuthentication"
       class="manage-link @(ViewData["ActivePage"]?.ToString() == ManageNavPages.TwoFactorAuthentication ? "active" : "")">
        🔐 Xác thực 2 bước
    </a>

    <a asp-page="./PersonalData"
       class="manage-link @(ViewData["ActivePage"]?.ToString() == ManageNavPages.PersonalData ? "active" : "")">
        🗑️ Dữ liệu cá nhân
    </a>
</nav>
