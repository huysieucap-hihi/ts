@page
@model IndexModel
@{
    ViewData["Title"] = "Quản lý thông tin";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="card">
    <h3>@ViewData["Title"]</h3>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="Username">Tài khoản</label>
            <input asp-for="Username" class="form-control" disabled />
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="Input.FullName">Họ và tên</label>
            <input asp-for="Input.FullName" class="form-control" placeholder="Nhập họ tên của bạn" />
            <span asp-validation-for="Input.FullName" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="Input.PhoneNumber">Số điện thoại</label>
            <input asp-for="Input.PhoneNumber" class="form-control" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label>Vai trò / Chức vụ</label>
            <input type="text" class="form-control" value="@string.Join(", ", Model.UserRoles)" disabled style="background-color: #e9ecef;" />
            <small class="form-text text-muted">Bạn không thể tự thay đổi chức vụ của mình.</small>
        </div>

        <button id="update-profile-button" type="submit" class="btn btn-primary">
            Lưu thay đổi
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}