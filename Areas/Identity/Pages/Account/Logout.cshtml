@page
@model LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="logout-page">

    <div class="logout-card">

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="logout-header">
                <div class="logout-icon danger">↪</div>
                <h2>Bạn có chắc muốn đăng xuất?</h2>
                <p>
                    Bạn đang đăng nhập với tài khoản<br />
                    <strong>@User.Identity?.Name</strong>
                </p>
            </div>

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                  method="post"
                  class="logout-actions">

                <button type="submit" class="btn btn-danger">
                    Có, đăng xuất ngay
                </button>

                <a asp-area="" asp-page="/Index" class="btn btn-outline">
                    Huỷ, quay lại trang chủ
                </a>
            </form>
        }
        else
        {
            <div class="logout-header">
                <div class="logout-icon success">✔</div>
                <h2>Đăng xuất thành công!</h2>
                <p>Bạn đã rời khỏi hệ thống an toàn.</p>
            </div>

            <div class="logout-actions">
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">
                    Đăng nhập lại
                </a>

                <a asp-area="" asp-page="/Index" class="btn btn-outline">
                    Về trang chủ
                </a>
            </div>
        }

        <div class="logout-footer">
            © 2025 <strong>Test Case Management System</strong>
        </div>

    </div>

</div>
