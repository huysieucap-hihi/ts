@model WebsiteQL_Testcase.ViewModels.DashboardIndexViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="khungvien">
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon total-icon">
            <i class="fa-solid fa-layer-group"></i>
        </div>
        <div>
            <p class="stat-label">Total test cases</p>
            <h3 class="stat-number">@Model.TotalCases</h3>
        </div>
    </div>

    <div class="stat-card pass">
        <div class="stat-icon pass-icon">
            <i class="fa-solid fa-check"></i>
        </div>
        <div>
            <p class="stat-label">Test cases Pass</p>
            <h3 class="stat-number">@Model.PassCount</h3>
        </div>
    </div>

    <div class="stat-card fail">
        <div class="stat-icon fail-icon">
            <i class="fa-solid fa-xmark"></i>
        </div>
        <div>
            <p class="stat-label">Test cases Fail</p>
            <h3 class="stat-number">@Model.FailCount</h3>
        </div>
    </div>
</div>

<div class="dashboard-card">
    <div class="card-header">
        <h4>Pass / Fail Overview</h4>
    </div>
    <div class="card-body">
        <div class="chart-container">
            <div class="progress-bar-wrapper">
                @if (Model.TotalCases > 0)
                {
                    <div class="bar-segment pass" style="width: @Model.PassRate%"></div>
                    <div class="bar-segment fail" style="width: @Model.FailRate%"></div>
                }
                else
                {
                    <div class="bar-segment empty" style="width: 100%; background: #eee;"></div>
                }
            </div>

            <div class="chart-legend">
                <div class="legend-item">
                    <span class="dot pass"></span>
                    <span>Pass: @Model.PassRate%</span>
                </div>
                <div class="legend-item">
                    <span class="dot fail"></span>
                    <span>Fail: @Model.FailRate%</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="lists-grid">
    <div class="dashboard-card">
        <div class="card-header">
            <h4>Latest Test Cases</h4>
        </div>
        <div class="card-body">
            <ul class="list-group">
                @if (Model.LatestTestCases != null && Model.LatestTestCases.Any())
                {
                    @foreach (var item in Model.LatestTestCases)
                    {
                        var statusClass = item.Status.ToLower();

                        <li class="list-item">
                            <span>@item.Name</span>
                            <span class="badge @statusClass">@item.Status</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-item" style="justify-content: center; color: #999;">
                        <span>No recent test cases found.</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="card-header">
            <h4>Latest Projects</h4>
        </div>
        <div class="card-body">
            <ul class="list-group">
                @if (Model.LatestProjects != null && Model.LatestProjects.Any())
                {
                    @foreach (var item in Model.LatestProjects)
                    {
                        <li class="list-item">
                            <div style="display:flex; flex-direction:column;">
                                <span style="font-weight:500">@item.Name</span>
                                <span style="font-size:12px; color:#888;">
                                    Updated: @item.UpdatedDate.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-item" style="justify-content: center; color: #999;">
                        <span>No recent projects found.</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
</div>