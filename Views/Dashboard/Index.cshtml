@model WebsiteQL_Testcase.ViewModels.DashboardIndexViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <h1 class="mb-4">Dashboard Tổng Quan</h1>

    <!-- Thống kê chính -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Total Test Cases</h5>
                    <h2 class="display-5 fw-bold">@Model.TotalCases</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Test Cases Pass</h5>
                    <h2 class="display-5 fw-bold text-success">@Model.PassCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center border-danger">
                <div class="card-body">
                    <h5 class="card-title text-danger">Test Cases Fail</h5>
                    <h2 class="display-5 fw-bold text-danger">@Model.FailCount</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ Pass/Fail -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Pass / Fail Chart</h5>
        </div>
        <div class="card-body">
            <div class="progress" style="height: 40px;">
                <div class="progress-bar bg-success" role="progressbar"
                     style="width: @Model.PassRate%"
                     aria-valuenow="@Model.PassRate" aria-valuemin="0" aria-valuemax="100">
                    <span class="fw-bold">@Model.PassRate% Pass</span>
                </div>
                <div class="progress-bar bg-danger" role="progressbar"
                     style="width: @Model.FailRate%"
                     aria-valuenow="@Model.FailRate" aria-valuemin="0" aria-valuemax="100">
                    <span class="fw-bold">@Model.FailRate% Fail</span>
                </div>
            </div>
            <small class="text-muted d-block mt-2">
                Chỉ tính các test case đã được chạy ít nhất 1 lần
            </small>
        </div>
    </div>

    <div class="row">
        <!-- Latest Test Cases -->
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Latest Test Cases</h5>
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả Project</a>
                </div>
                <div class="card-body">
                    @if (!Model.LatestTestCases.Any())
                    {
                        <p class="text-muted">Chưa có execution nào.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.LatestTestCases)
                            {
                                <a asp-controller="TestCases" asp-action="Details" asp-route-id="@item.Id"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@item.Code</strong> - @item.Title
                                        <br />
                                        <small class="text-muted">Suite: @item.TestSuiteName</small>
                                    </div>
                                    <span class="badge @(item.LatestResult == WebsiteQL_Testcase.Models.Enums.TestResult.Pass ? "bg-success" :
                                                                                                item.LatestResult == WebsiteQL_Testcase.Models.Enums.TestResult.Fail ? "bg-danger" :
                                                                                                item.LatestResult == WebsiteQL_Testcase.Models.Enums.TestResult.Pending ? "bg-warning" :
                                                                                                item.LatestResult == WebsiteQL_Testcase.Models.Enums.TestResult.Skipped ? "bg-secondary" : "bg-light text-dark")">
                                @(item.LatestResult?.ToString()  ?? "Chưa chạy")
                            </span>
                        </a>
                                                }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Latest Projects -->
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Latest Projects</h5>
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
                </div>
                <div class="card-body">
                    @if (!Model.LatestProjects.Any())
                    {
                        <p class="text-muted">Chưa có project nào.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.LatestProjects)
                            {
                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@item.Id"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@item.Name</strong>
                                        <br />
                                        <small class="text-muted">Tạo ngày @item.CreatedAt.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <span class="text-muted">→</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>