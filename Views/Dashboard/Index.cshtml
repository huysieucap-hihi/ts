@model WebsiteQL_Testcase.ViewModels.DashboardIndexViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard Tổng Quan</h1>

<div class="stat-grid">
    <div class="stat-card">
        <h4>Total Test Cases</h4>
        <strong>@Model.TotalCases</strong>
    </div>

    <div class="stat-card success">
        <h4>Pass</h4>
        <strong>@Model.PassCount</strong>
    </div>

    <div class="stat-card danger">
        <h4>Fail</h4>
        <strong>@Model.FailCount</strong>
    </div>
</div>


<div class="grid-3">
    <div class="card">
        <h4>Total Test Cases</h4>
        <strong>@Model.TotalCases</strong>
    </div>

    <div class="card">
        <h4>Pass</h4>
        <strong>@Model.PassCount</strong>
    </div>

    <div class="card">
        <h4>Fail</h4>
        <strong>@Model.FailCount</strong>
    </div>
</div>

<div class="progress" style="margin-top:16px">
    <div class="progress-pass" style="width:@Model.PassRate%">@Model.PassRate% Pass</div>
    <div class="progress-fail" style="width:@Model.FailRate%">@Model.FailRate% Fail</div>
</div>
