@model IEnumerable<WebsiteQL_Testcase.Models.Project>

@{
    ViewData["Title"] = "Danh sách Project";
}

@* ================= HEADER & ACTIONS ================= *@
<div class="page-header-container">
    <div class="page-title">
        <h2>Projects</h2>
    </div>

    <div class="page-actions">
        <a asp-action="Create" class="btn-custom btn-create">
            + Tạo Project Mới
        </a>
    </div>
</div>

@* ================= THÔNG BÁO (ALERT) ================= *@
@if (TempData["Success"] != null)
{
    <div class="alert-box" id="successAlert">
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close-alert" onclick="document.getElementById('successAlert').style.display='none'">×</button>
    </div>
}

@* ================= NỘI DUNG BẢNG ================= *@
@if (!Model.Any())
{
    <div class="empty-state">
        <h4>Chưa có Project nào</h4>
        <p>Hãy tạo Project đầu tiên để bắt đầu quản lý Test Case.</p>
        <a asp-action="Create" style="color: #007bff; text-decoration: none; font-weight: bold;">
            Tạo Project ngay
        </a>
    </div>
}
else
{
    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Tên Project</th>
                    <th>Mô tả</th>
                    <th>Ngày tạo</th>
                    <th style="width: 250px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @* Click vào tên để xem chi tiết luôn cho tiện *@
                            <a asp-action="Details" asp-route-id="@item.Id" style="font-weight: bold; color: inherit; text-decoration: none;">
                                @item.Name
                            </a>
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)
                        </td>
                        <td>
                            @item.CreatedAt.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @* Các nút bấm chuẩn style mới *@
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-custom btn-sm-custom btn-detail">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-custom btn-sm-custom btn-edit">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-custom btn-sm-custom btn-delete">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}