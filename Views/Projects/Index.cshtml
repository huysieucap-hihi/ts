@model IEnumerable<WebsiteQL_Testcase.Models.Project>

@{
    ViewData["Title"] = "Project Management";
}

<div class="khungvien">
    <div class="main-card">

        <div class="card-toolbar">
            <form asp-controller="Projects" asp-action="Index" method="get" style="display: flex;">
                <div class="search-wrapper">
                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           placeholder="Search by project name..."
                           class="search-input" />

                    <button type="submit" style="background:none; border:none; cursor:pointer;"
                    </button>
                </div>
            </form>

            <a asp-action="Create" class="btn-add-project">
                + Add new project
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-box" id="successAlert" style="margin: 0 20px 20px 20px;">
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close-alert" onclick="document.getElementById('successAlert').style.display='none'">×</button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No projects found matching your search.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Project name</th>
                            <th style="width: 40%;">Description</th>
                            <th style="width: 20%; text-align: center;">Total test case</th>
                            <th style="width: 15%; text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="project-link">
                                        @item.Name
                                    </a>
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrEmpty(item.Description) ? "" : item.Description)
                                </td>
                                <td style="text-align: center;">
                                    36
                                </td>
                                <td class="action-cell">
                                    <a asp-action="Edit" asp-route-id="@item.Id" title="Edit" class="icon-btn edit">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" title="Delete" class="icon-btn delete">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>