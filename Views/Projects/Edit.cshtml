@model WebsiteQL_Testcase.Models.Project

@{
    ViewData["Title"] = "Sửa Project";
}

@* BỌC TOÀN BỘ TRONG CONTAINER-CENTER *@
<div class="container-center">

    @* HEADER *@
    <div class="page-header-container">
        <div class="page-title">
            <h2>@ViewData["Title"]: <strong>@Model.Name</strong></h2>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        @* Giữ nguyên CreatedAt, UpdatedAt sẽ được xử lý ở Controller *@

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @* NỘI DUNG FORM *@
        <div class="content-box" style="max-width: 800px;">
            <h4 class="box-title">Thông tin cập nhật</h4>

            <div class="form-group">
                <label asp-for="Name" class="form-label required">Tên Project</label>
                <input asp-for="Name" class="form-input" placeholder="Nhập tên dự án..." required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <textarea asp-for="Description" class="form-input" rows="5" placeholder="Mô tả chi tiết về dự án này..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @* BUTTONS *@
            <div class="action-group" style="margin-top: 20px;">
                <button type="submit" class="btn-custom btn-create" style="padding: 10px 25px; font-size: 1rem;">
                    Lưu Cập Nhật
                </button>
                <a asp-action="Index" class="btn-custom btn-back" style="padding: 10px 25px; font-size: 1rem;">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}