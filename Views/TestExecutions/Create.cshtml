@model WebsiteQL_Testcase.Models.TestExecution

@{
    ViewData["Title"] = "Chạy Test Case";
    var testCaseCode = ViewData["TestCaseCode"] as string;
    var testCaseTitle = ViewData["TestCaseTitle"] as string;
    var testSuiteName = ViewData["TestSuiteName"] as string;
    var projectName = ViewData["ProjectName"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3>Chạy Test: <strong>@testCaseCode - @testCaseTitle</strong></h3>
        <p class="text-muted mb-0">
            <small>Suite: @testSuiteName | Project: @projectName</small>
        </p>
    </div>
    <a asp-controller="TestCases" asp-action="Details" asp-route-id="@Model.TestCaseId" class="btn btn-outline-secondary">
        ← Quay lại chi tiết Test Case
    </a>
</div>
<!-- HIỂN THỊ LỖI CHI TIẾT (DEBUG) -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning mb-4">
        <strong>Lỗi validation (debug):</strong>
        <ul>
            @foreach (var key in ViewData.ModelState.Keys)
            {
                var state = ViewData.ModelState[key];
                if (state.Errors.Count > 0)
                {
                    <li><strong>@key</strong>: @string.Join(", ", state.Errors.Select(e => e.ErrorMessage))</li>
                }
            }
        </ul>
    </div>
}
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="TestCaseId" />

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Kết quả chạy test</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Result" class="form-label fw-bold">Kết quả</label>
                        <select asp-for="Result" class="form-select form-select-lg">
                            <option value="3" selected>Pending</option>
                            <option value="1">Pass</option>
                            <option value="2">Fail</option>
                            <option value="4">Skipped</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ActualResult" class="form-label fw-bold">Actual Result (mô tả thực tế)</label>
                        <textarea asp-for="ActualResult" class="form-control" rows="6" placeholder="Mô tả kết quả thực tế khi chạy test..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label fw-bold">Note / Bug link</label>
                        <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú, link Jira, screenshot..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100">Lưu kết quả chạy test</button>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Test Steps (@Model.TestCase.Steps.Count steps)</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th width="80">Step</th>
                                    <th>Action</th>
                                    <th>Expected Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var step in Model.TestCase.Steps.OrderBy(s => s.StepNumber))
                                {
                                    <tr>
                                        <th class="text-center">@step.StepNumber</th>
                                        <td>@step.Action</td>
                                        <td>@step.ExpectedResult</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.TestCase.Steps.Any())
                    {
                        <p class="text-muted text-center">Chưa có Test Step nào.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        // Tự động thay đổi màu nút submit theo Result
        document.querySelector('[asp-for="Result"]').addEventListener('change', function () {
            const btn = document.querySelector('button[type="submit"]');
            const value = this.value;
            btn.classList.remove('btn-success', 'btn-danger', 'btn-warning', 'btn-secondary');
            if (value == 1) btn.classList.add('btn-success');
            else if (value == 2) btn.classList.add('btn-danger');
            else if (value == 4) btn.classList.add('btn-secondary');
            else btn.classList.add('btn-warning');
            btn.textContent = value == 1 ? 'Lưu - PASS' : value == 2 ? 'Lưu - FAIL' : value == 4 ? 'Lưu - SKIPPED' : 'Lưu - PENDING';
        });
    </script>
}