@model WebsiteQL_Testcase.Models.TestExecution

@{
    ViewData["Title"] = "Chạy Test Case";
    var testCaseCode = ViewData["TestCaseCode"] as string;
    var testCaseTitle = ViewData["TestCaseTitle"] as string;
    var testSuiteName = ViewData["TestSuiteName"] as string;
    var projectName = ViewData["ProjectName"] as string;
}

@* HEADER *@
<div class="page-header-container">
    <div class="page-title">
        <h2>Chạy Test: <strong>@testCaseCode</strong></h2>
        <div style="font-size: 0.95rem; color: #666; margin-top: 8px;">
            <div style="font-weight: 500;">@testCaseTitle</div>
            <small style="opacity: 0.8;">Suite: <strong>@testSuiteName</strong> | Project: <strong>@projectName</strong></small>
        </div>
    </div>

    <div class="page-actions">
        <a asp-controller="TestCases" asp-action="Details" asp-route-id="@Model.TestCaseId" class="btn-custom btn-back">
            ← Quay lại Test Case
        </a>
    </div>
</div>

@* ERROR DEBUG *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert-box danger" style="margin-bottom: 20px;">
        <div>
            <strong>Lỗi Validation:</strong>
            <ul style="margin: 5px 0 0 20px; padding: 0;">
                @foreach (var key in ViewData.ModelState.Keys)
                {
                    var state = ViewData.ModelState[key];
                    if (state.Errors.Count > 0)
                    {
                        <li><strong>@key</strong>: @string.Join(", ", state.Errors.Select(e => e.ErrorMessage))</li>
                    }
                }
            </ul>
        </div>
    </div>
}

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="TestCaseId" />

    <div class="details-layout">

        @* --- CỘT TRÁI: NHẬP KẾT QUẢ --- *@
        <div class="details-sidebar" style="order: 1;">
            <div class="content-box sidebar-box" style="position: sticky; top: 20px;">
                <h4 class="box-title">Kết quả chạy test</h4>

                <div class="form-group">
                    <label asp-for="Result" class="form-label fw-bold">Kết quả</label>
                    @* ID ResultSelect dùng để JS bắt sự kiện *@
                    <select asp-for="Result" class="form-input" id="ResultSelect" style="font-weight: bold;">
                        <option value="3" selected>Pending</option>
                        <option value="1">Pass</option>
                        <option value="2">Fail</option>
                        <option value="4">Skipped</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="ActualResult" class="form-label fw-bold">Actual Result (Thực tế)</label>
                    <textarea asp-for="ActualResult" class="form-input" rows="6" placeholder="Mô tả kết quả thực tế khi chạy test..."></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="Note" class="form-label fw-bold">Note / Bug link</label>
                    <textarea asp-for="Note" class="form-input" rows="3" placeholder="Ghi chú, link Jira, screenshot..."></textarea>
                </div>

                @* ID btnSubmit dùng để JS đổi màu *@
                <button type="submit" id="btnSubmit" class="btn-custom btn-create w-100" style="margin-top: 10px; padding: 12px; font-size: 1.1rem; justify-content: center;">
                    Lưu Kết Quả
                </button>
            </div>
        </div>

        @* --- CỘT PHẢI: XEM STEPS --- *@
        <div class="details-main" style="order: 2;">
            <div class="content-box">
                <h4 class="box-title">
                    Test Steps (@(Model.TestCase?.Steps?.Count ?? 0) bước)
                </h4>

                @if (Model.TestCase != null && Model.TestCase.Steps != null && Model.TestCase.Steps.Any())
                {
                    <div class="table-container">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th style="width: 60px; text-align: center;">#</th>
                                    <th>Hành động (Action)</th>
                                    <th>Kết quả mong đợi (Expected)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var step in Model.TestCase.Steps.OrderBy(s => s.StepNumber))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: bold;">@step.StepNumber</td>
                                        <td>@step.Action</td>
                                        <td>@step.ExpectedResult</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-small">Chưa có Test Step nào.</div>
                }
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @* Không có script ở đây *@
}