@using WebsiteQL_Testcase.Models.Enums
@model IEnumerable<WebsiteQL_Testcase.Models.TestExecution>

@{
    ViewData["Title"] = "Lịch Sử Chạy Test";

    // Lấy ID chính xác từ Controller truyền sang
    var testCaseId = ViewData["TestCaseId"];
    var testCaseCode = ViewData["TestCaseCode"];
    var testCaseTitle = ViewData["TestCaseTitle"];
    var suiteName = ViewData["SuiteName"];
    var projectName = ViewData["ProjectName"];
}

@* BỌC TOÀN BỘ TRONG CONTAINER-CENTER *@
<div class="container-center">

    @* ================= HEADER & ACTIONS ================= *@
    <div class="page-header-container">
        <div class="page-title">
            <h2>Lịch sử chạy: <strong>@testCaseCode</strong></h2>
            <div style="font-size: 0.95rem; color: #666; margin-top: 8px; line-height: 1.5;">
                <div style="font-weight: 500; margin-bottom: 4px;">@testCaseTitle</div>
                <small style="opacity: 0.8;">
                    Suite: <strong>@suiteName</strong> | Project: <strong>@projectName</strong>
                </small>
            </div>
        </div>

        <div class="page-actions">
            @* NÚT QUAY LẠI CHÍNH XÁC *@
            <a asp-controller="TestCases"
               asp-action="Details"
               asp-route-id="@testCaseId"
               class="btn-custom btn-back">
                ← Quay lại Test Case
            </a>
        </div>
    </div>

    @* ================= NỘI DUNG ================= *@
    @if (!Model.Any())
    {
        <div class="empty-state">
            <h4>Chưa có lịch sử chạy test</h4>
            <p>Test Case này chưa được thực thi lần nào.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Ngày Chạy</th>
                        <th>Kết Quả</th>
                        <th>Actual Result</th>
                        <th>Note / Bug</th>
                        <th>Người Chạy</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var execution in Model)
                    {
                        <tr>
                            <td>@execution.ExecutedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge @execution.Result.ToString().ToLower()">
                                    @execution.Result
                                </span>
                            </td>
                            <td>@(string.IsNullOrEmpty(execution.ActualResult) ? "-" : execution.ActualResult)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(execution.Note) && execution.Note.StartsWith("http"))
                                {
                                    <a href="@execution.Note" target="_blank" style="color: #007bff; text-decoration: underline;">Xem Link</a>
                                }
                                else
                                {
                                    @(string.IsNullOrEmpty(execution.Note) ? "-" : execution.Note)
                                }
                            </td>
                            <td>@(execution.ExecutedBy?.UserName ?? "Không xác định")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>