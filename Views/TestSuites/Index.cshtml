@model IEnumerable<WebsiteQL_Testcase.Models.TestSuite>

@{
    ViewData["Title"] = "Test Suites";
    var projectId = ViewData["ProjectId"] as Guid?;
    var projectName = ViewData["ProjectName"] as string;
}
<div class="khungvien">
<div class="page-header-container">
    <div class="page-title">
        <h2>Test Suites: <strong>@projectName</strong></h2>
    </div>

    <div class="page-actions">
        <a asp-controller="Projects" asp-action="Index" class="btn-custom btn-back">
            ← Quay lại Project
        </a>
        <a asp-action="Create" asp-route-projectId="@projectId" class="btn-custom btn-create">
            + Tạo Test Suite
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-box" id="successAlert">
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close-alert" onclick="document.getElementById('successAlert').style.display='none'">×</button>
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <p>Chưa có Test Suite nào trong dự án này.</p>
        <a asp-action="Create" asp-route-projectId="@projectId" style="color: #007bff; text-decoration: none; font-weight: bold;">
            Tạo Suite đầu tiên ngay
        </a>
    </div>
}
else
{
    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Tên Suite</th>
                    <th>Mô tả</th>
                    <th>Số Test Case</th>
                    <th style="width: 220px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong style="font-size: 1.05rem;">@item.Name</strong>
                        </td>
                        <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                        <td>
                            <span style="background: #eee; padding: 2px 8px; border-radius: 10px; font-size: 0.85rem; color: #333;">
                                @item.TestCases.Count
                            </span>
                        </td>
                            <td class="action text-right">

                                <a asp-action="Details" asp-route-id="@item.Id" title="Chi tiết">
                                    <i class="fa-solid fa-circle-info"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.Id" title="Sửa">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id" title="Xóa" class="delete-icon">
                                    <i class="fa-solid fa-trash-can"></i>
                                </a>

                            </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>