@model WebsiteQL_Testcase.Models.TestSuite

@{
    ViewData["Title"] = "Sửa Test Suite";
    var projectName = ViewData["ProjectName"] as string;
}

@* --- PHẦN 1: HEADER (Có container-center để canh giữa) --- *@
<div class="container-center">
    <div class="page-header-container">
        <div class="page-title">
            <h2>@ViewData["Title"]: <strong>@Model.Name</strong></h2>
            @if (!string.IsNullOrEmpty(projectName))
            {
                <div style="font-size: 0.95rem; color: #666; margin-top: 8px;">
                    Thuộc Project: <strong>@projectName</strong>
                </div>
            }
        </div>
    </div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    @* Giữ lại các input hidden quan trọng *@
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ProjectId" />

    @* --- PHẦN 2: FORM CONTENT (Có container-center để canh giữa) --- *@
    <div class="container-center">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="content-box">
            <h4 class="box-title">Thông tin cập nhật</h4>

            <div class="form-group">
                <label asp-for="Name" class="form-label required">Tên Test Suite</label>
                <input asp-for="Name" class="form-input" placeholder="Nhập tên suite..." required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <textarea asp-for="Description" class="form-input" rows="5" placeholder="Mô tả chi tiết về bộ test này..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @* BUTTONS *@
            <div class="action-group" style="margin-top: 30px;">
                <button type="submit" class="btn-custom btn-create" style="padding: 10px 25px; font-size: 1rem;">
                    Lưu Cập Nhật
                </button>

                <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn-custom btn-back" style="padding: 10px 25px; font-size: 1rem;">
                    Quay lại danh sách
                </a>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}