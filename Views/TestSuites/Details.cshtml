@model WebsiteQL_Testcase.Models.TestSuite

@{
    ViewData["Title"] = "Sửa Test Suite";
}

@* BỌC TOÀN BỘ TRONG CONTAINER-CENTER *@
<div class="container-center">

    @* HEADER *@
    <div class="page-header-container">
        <div class="page-title">
            <h2>@ViewData["Title"]: <strong>@Model.Name</strong></h2>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        @* Giữ lại các input hidden quan trọng *@
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProjectId" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @* NỘI DUNG FORM *@
        <div class="content-box" style="max-width: 800px;">
            <h4 class="box-title">Thông tin cập nhật</h4>

            <div class="form-group">
                <label asp-for="Name" class="form-label required">Tên Test Suite</label>
                <input asp-for="Name" class="form-input" placeholder="Ví dụ: Smoke Test..." required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <textarea asp-for="Description" class="form-input" rows="5" placeholder="Mô tả chi tiết bộ test này..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        @* BUTTONS *@
        <div class="action-group" style="margin-top: 20px;">
            <button type="submit" class="btn-custom btn-create" style="padding: 10px 25px; font-size: 1rem;">
                Lưu Cập Nhật
            </button>

            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn-custom btn-back" style="padding: 10px 25px; font-size: 1rem;">
                Quay lại danh sách
            </a>
        </div>
    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}