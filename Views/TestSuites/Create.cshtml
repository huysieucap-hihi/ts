@model WebsiteQL_Testcase.Models.TestSuite

@{
    ViewData["Title"] = "Tạo Test Suite Mới";
    var projectName = ViewData["ProjectName"] as string ?? "Không xác định";
}

@* HEADER CANH GIỮA *@
<div class="container-center">
    <div class="page-header-container">
        <div class="page-title">
            <h2>@ViewData["Title"]</h2>
            <div style="font-size: 0.95rem; color: #666; margin-top: 8px;">
                Thuộc Project: <strong>@projectName</strong>
            </div>
        </div>
    </div>
</div>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="ProjectId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @* FORM CANH GIỮA *@
    <div class="container-center">
        <div class="content-box">
            <h4 class="box-title">Thông tin Test Suite</h4>

            <div class="form-group">
                <label asp-for="Name" class="form-label required">Tên Test Suite</label>
                <input asp-for="Name" class="form-input" placeholder="Ví dụ: Smoke Test, Regression Test..." required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <label asp-for="Description" class="form-label">Mô tả (tùy chọn)</label>
                <textarea asp-for="Description" class="form-input" rows="5" placeholder="Mô tả chi tiết bộ test này dùng để làm gì..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="action-group" style="margin-top: 20px;">
                <button type="submit" class="btn-custom btn-create" style="padding: 10px 25px; font-size: 1rem;">
                    Lưu Test Suite
                </button>
                <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn-custom btn-back" style="padding: 10px 25px; font-size: 1rem;">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}