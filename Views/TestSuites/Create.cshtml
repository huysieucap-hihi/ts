@model WebsiteQL_Testcase.Models.TestSuite

@{
    ViewData["Title"] = "Tạo Test Suite Mới";
    var projectName = ViewData["ProjectName"] as string ?? "Không xác định";
}

<div class="container py-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">@ViewData["Title"]</h3>
        </div>
        <div class="card-body">
            <p class="mb-4 fs-5"><strong>Project:</strong> @projectName</p>

            <form asp-action="Create" method="post">
                <!-- BẮT BUỘC CÓ DÒNG NÀY, LẤY PROJECTID TỪ MODEL -->
                <input type="hidden" asp-for="ProjectId" />

                <!-- Hiển thị lỗi rõ ràng -->
                <div asp-validation-summary="All" class="alert alert-danger mb-4" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-bold">
                        Tên Test Suite <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="Ví dụ: Smoke Test, Regression Test..." required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả (tùy chọn)</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Mô tả chi tiết bộ test này dùng để làm gì..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-success btn-lg px-5">
                        <i class="bi bi-check-circle-fill me-2"></i> Tạo Test Suite
                    </button>
                    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary btn-lg">
                        <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}