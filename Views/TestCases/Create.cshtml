@model WebsiteQL_Testcase.Models.TestCase

@{
    ViewData["Title"] = "Tạo Test Case Mới";
    var testSuiteName = ViewData["TestSuiteName"] as string;
    var projectName = ViewData["ProjectName"] as string;
}

@* HEADER *@
<div class="page-header-container">
    <div class="page-title">
        <h2>@ViewData["Title"]</h2>
        <div style="font-size: 0.95rem; color: #666; margin-top: 8px;">
            Project: <strong>@projectName</strong> | Suite: <strong>@testSuiteName</strong>
        </div>
    </div>
</div>

@* ERROR DEBUG (Giữ lại logic của bạn nhưng style lại) *@
@if (ViewBag.ModelStateErrors != null)
{
    <div class="alert-box danger" style="margin-bottom: 20px;">
        <div>
            <strong>Lỗi Validation:</strong>
            <ul style="margin: 5px 0 0 20px; padding: 0;">
                @foreach (var error in ViewBag.ModelStateErrors as Dictionary<string, string[]>)
                {
                    <li>@error.Key: @string.Join(", ", error.Value)</li>
                }
            </ul>
        </div>
    </div>
}

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="TestSuiteId" />
    <input type="hidden" asp-for="CreatedAt" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @* PHẦN 1: THÔNG TIN CHUNG *@
    <div class="content-box">
        <h4 class="box-title">Thông tin chung</h4>

        <div class="form-grid">
            @* Cột 1 *@
            <div class="form-group">
                <label asp-for="Code" class="form-label required">Mã Test Case</label>
                <input asp-for="Code" class="form-input" placeholder="VD: TC_LOGIN_001" required />
                <span asp-validation-for="Code" class="text-danger"></span>
                <small class="form-hint">Mã định danh duy nhất cho Test Case này.</small>
            </div>

            @* Cột 2 *@
            <div class="form-group">
                <label asp-for="Title" class="form-label required">Tiêu đề</label>
                <input asp-for="Title" class="form-input" placeholder="Nhập tiêu đề ngắn gọn" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            @* Cột 3 *@
            <div class="form-group">
                <label asp-for="Priority" class="form-label">Độ ưu tiên</label>
                <select asp-for="Priority" class="form-input">
                    <option value="">-- Chọn --</option>
                    <option value="1">Low</option>
                    <option value="2" selected>Medium</option>
                    <option value="3">High</option>
                    <option value="4">Critical</option>
                </select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>

            @* Cột 4 *@
            <div class="form-group">
                <label asp-for="Status" class="form-label">Trạng thái</label>
                <select asp-for="Status" class="form-input">
                    <option value="1" selected>Draft</option>
                    <option value="2">Active</option>
                    <option value="3">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        @* Full width description *@
        <div class="form-group" style="margin-top: 15px;">
            <label asp-for="Description" class="form-label">Mô tả chi tiết</label>
            <textarea asp-for="Description" class="form-input" rows="4" placeholder="Mô tả tiền điều kiện, mục đích..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    @* PHẦN 2: TEST STEPS *@
    <div class="content-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
            <h4 class="box-title" style="margin: 0; border: none;">Test Steps</h4>
            <button type="button" class="btn-custom btn-create" onclick="addStep()" style="font-size: 0.9rem; padding: 6px 12px;">
                + Thêm Step
            </button>
        </div>

        <div id="steps-container">
            @* Step mặc định *@
            <div class="step-item" data-step="1">
                <div class="step-header">
                    <span class="step-badge">Step 1</span>
                    <button type="button" class="btn-close-step" onclick="removeStep(this)" title="Xóa step này">×</button>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Hành động (Action)</label>
                        <textarea name="Actions[0]" class="form-input" rows="2" placeholder="Nhập hành động..." required></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kết quả mong đợi (Expected)</label>
                        <textarea name="ExpectedResults[0]" class="form-input" rows="2" placeholder="Nhập kết quả..."></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ACTION BUTTONS *@
    <div class="action-group" style="margin-top: 20px;">
        <button type="submit" class="btn-custom btn-create" style="padding: 10px 25px; font-size: 1rem;">
            Lưu Test Case
        </button>
        <a asp-action="Index" asp-route-testSuiteId="@Model.TestSuiteId" class="btn-custom btn-back" style="padding: 10px 25px; font-size: 1rem;">
            Hủy bỏ
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let stepCounter = 1;

        function addStep() {
            stepCounter++;
            const container = document.getElementById('steps-container');
            const newStep = document.createElement('div');
            newStep.className = 'step-item';
            newStep.dataset.step = stepCounter;

            // HTML Template string đã được loại bỏ class Bootstrap
            newStep.innerHTML = `
                <div class="step-header">
                    <span class="step-badge">Step ${stepCounter}</span>
                    <button type="button" class="btn-close-step" onclick="removeStep(this)" title="Xóa step này">×</button>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Hành động (Action)</label>
                        <textarea name="Actions[${stepCounter - 1}]" class="form-input" rows="2" placeholder="Nhập hành động..." required></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kết quả mong đợi (Expected)</label>
                        <textarea name="ExpectedResults[${stepCounter - 1}]" class="form-input" rows="2" placeholder="Nhập kết quả..."></textarea>
                    </div>
                </div>
            `;
            container.appendChild(newStep);
        }

        function removeStep(button) {
            const stepItem = button.closest('.step-item');
            stepItem.remove();

            // Re-index logic (Giữ nguyên logic của bạn)
            const steps = document.querySelectorAll('.step-item');
            steps.forEach((step, index) => {
                const newIndex = index + 1;
                step.dataset.step = newIndex;
                step.querySelector('.step-badge').textContent = `Step ${newIndex}`;

                const action = step.querySelector('textarea[name^="Actions"]');
                const expected = step.querySelector('textarea[name^="ExpectedResults"]');

                if (action) {
                    action.name = `Actions[${index}]`;
                    action.placeholder = `Nhập hành động...`; // Reset placeholder nếu cần
                }
                if (expected) expected.name = `ExpectedResults[${index}]`;
            });
            stepCounter = steps.length;
        }
    </script>
}