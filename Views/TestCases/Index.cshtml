@model IEnumerable<WebsiteQL_Testcase.Models.TestCase>

@{
    ViewData["Title"] = "Test Cases";
    var testSuiteId = ViewData["TestSuiteId"] as Guid?;
    var testSuiteName = ViewData["TestSuiteName"] as string;
    var projectName = ViewData["ProjectName"] as string;
}

@* BỌC TOÀN BỘ TRONG CONTAINER-CENTER *@
<div class="container-center">

    @* HEADER & ACTIONS *@
    <div class="page-header-container">
        <div class="page-title">
            <h2>Test Cases: <strong>@testSuiteName</strong></h2>
            <div style="font-size: 0.9rem; color: #666; margin-top: 4px;">Project: @projectName</div>
        </div>

        <div class="page-actions">
            @* NÚT QUAY LẠI: 
               - Controller: TestSuites (Về trang Suite)
               - Action: Index (Danh sách)
               - Route ProjectId: Cần thiết để TestSuites/Index biết hiển thị suite của dự án nào.
            *@
            <a asp-controller="TestSuites"
               asp-action="Index"
               asp-route-projectId="@ViewData["ProjectId"]"
               class="btn-custom btn-back">
                ← Quay lại danh sách Suite
            </a>

            @* Nút tạo mới Test Case (Dùng TestSuiteId) *@
            <a asp-action="Create"
               asp-route-testSuiteId="@testSuiteId"
               class="btn-custom btn-create">
                + Tạo Test Case
            </a>
        </div>
    </div>

    @* ALERT SUCCESS *@
    @if (TempData["Success"] != null)
    {
        <div class="alert-box" id="successAlert">
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close-alert" onclick="document.getElementById('successAlert').style.display='none'">×</button>
        </div>
    }

    @* CONTENT *@
    @if (!Model.Any())
    {
        <div class="empty-state">
            <h4>Chưa có Test Case nào</h4>
            <p>Tạo Test Case đầu tiên để bắt đầu quy trình kiểm thử.</p>
            <a asp-action="Create"
               asp-route-testSuiteId="@testSuiteId"
               style="color: #007bff; text-decoration: none; font-weight: bold;">
                Tạo Test Case ngay
            </a>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Latest Result</th>
                        <th>Created</th>
                        <th style="width: 280px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" style="font-weight: bold; color: inherit; text-decoration: none;">
                                    @item.Code
                                </a>
                            </td>
                            <td>@item.Title</td>

                            @* Priority Badge *@
                            <td>
                                <span class="badge @item.Priority.ToString().ToLower()">
                                    @item.Priority
                                </span>
                            </td>

                            @* Status Badge *@
                            <td>
                                <span class="badge @item.Status.ToString().ToLower()">
                                    @item.Status
                                </span>
                            </td>

                            @* Latest Result Badge *@
                            <td>
                                @if (item.LatestResult.HasValue)
                                {
                                    <span class="badge @item.LatestResult.ToString().ToLower()">
                                        @item.LatestResult
                                    </span>
                                }
                                else
                                {
                                    <span class="badge none">Chưa chạy</span>
                                }
                            </td>

                            <td>@item.CreatedAt.ToString("dd/MM/yy")</td>

                            <td>
                                @* Nút Chạy (Run) - Màu xanh lá *@
                                <a asp-controller="TestExecutions"
                                   asp-action="Create"
                                   asp-route-testCaseId="@item.Id"
                                   class="btn-custom btn-sm-custom btn-run"
                                   title="Chạy Test">
                                    ▶ Chạy
                                </a>

                                @* Các nút thao tác chuẩn *@
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-custom btn-sm-custom btn-detail">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-custom btn-sm-custom btn-edit">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-custom btn-sm-custom btn-delete">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>