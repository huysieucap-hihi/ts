@model IEnumerable<WebsiteQL_Testcase.Models.TestCase>

@{
    ViewData["Title"] = "Test Cases";
    var testSuiteId = ViewData["TestSuiteId"] as Guid?;
    var testSuiteName = ViewData["TestSuiteName"] as string;
    var projectName = ViewData["ProjectName"] as string;
}

<h2 class="mb-4">Test Cases trong: <strong>@testSuiteName</strong></h2>
<p><small><i>Project: @projectName</i></small></p>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-controller="TestSuites" asp-action="Index" asp-route-projectId="@ViewData["ProjectId"]" class="btn btn-outline-secondary">
            ← Quay lại Test Suites
        </a>
    </div>
    <a asp-action="Create" asp-route-testSuiteId="@testSuiteId" class="btn btn-primary">
        + Tạo Test Case Mới
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-file-earmark-text fs-1 text-muted mb-3"></i>
        <h5>Chưa có Test Case nào</h5>
        <p class="text-muted">Tạo Test Case đầu tiên để bắt đầu.</p>
        <a asp-action="Create" asp-route-testSuiteId="@testSuiteId" class="btn btn-primary">Tạo Test Case</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Latest Result</th>
                    <th>Created</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                <strong>@item.Code</strong>
                            </a>
                        </th>
                        <td>@item.Title</td>
                        <td>
                            <span class="badge @(item.Priority == WebsiteQL_Testcase.Models.Enums.TestPriority.Critical ? "bg-danger" :
                                                                        item.Priority == WebsiteQL_Testcase.Models.Enums.TestPriority.High ? "bg-warning" :
                                                                        item.Priority == WebsiteQL_Testcase.Models.Enums.TestPriority.Medium ? "bg-info" : "bg-secondary")">
                        @item.Priority
                    </span>
                </td>
                <td>
                    <span class="badge @(item.Status == WebsiteQL_Testcase.Models.Enums.TestStatus.Active ? "bg-success" :
                                                                item.Status == WebsiteQL_Testcase.Models.Enums.TestStatus.Draft ? "bg-warning" : "bg-secondary")">
                        @item.Status
                    </span>
                </td>
                <td>
                    @if (item.LatestResult.HasValue)
                            {
                                <span class="badge @(item.LatestResult == WebsiteQL_Testcase.Models.Enums.TestResult.Pass ? "bg-success" :
                                                                                item.LatestResult == WebsiteQL_Testcase.Models.Enums.TestResult.Fail ? "bg-danger" :
                                                                                item.LatestResult == WebsiteQL_Testcase.Models.Enums.TestResult.Pending ? "bg-warning" : "bg-secondary")">
                        @item.LatestResult
                    </span>
                                        }
                            else
                            {
                                <span class="badge bg-light text-dark">Chưa chạy</span>
                            }
                        </td>
                        <td>@item.CreatedAt.ToString("dd/MM/yy")</td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Xóa</a>
                                <!-- NÚT CHẠY TEST NHANH -->
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#runTestModal-@item.Id">
                                    <i class="bi bi-play-fill"></i> Chạy
                                </button>
                            </div>

                            <!-- Modal Chạy Test Nhanh -->
                            <div class="modal fade" id="runTestModal-@item.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header bg-primary text-white">
                                            <h5 class="modal-title">
                                                <i class="bi bi-play-circle-fill me-2"></i>
                                                Chạy Test: <strong>@item.Code - @item.Title</strong>
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-controller="TestExecutions" asp-action="Create" method="post">
                                            <div class="modal-body">
                                                <input type="hidden" name="TestCaseId" value="@item.Id" />

                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Kết quả</label>
                                                    <select name="Result" class="form-select form-select-lg" required>
                                                        <option value="Pass">Pass</option>
                                                        <option value="Fail">Fail</option>
                                                        <option value="Pending">Pending</option>
                                                        <option value="Skipped">Skipped</option>
                                                    </select>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Actual Result (mô tả thực tế)</label>
                                                    <textarea name="ActualResult" class="form-control" rows="4" placeholder="Mô tả kết quả thực tế..."></textarea>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Note / Bug Link</label>
                                                    <input name="Note" class="form-control" placeholder="Ghi chú hoặc link bug (Jira, GitHub...)" />
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="submit" class="btn btn-success btn-lg">
                                                    <i class="bi bi-check-circle-fill me-2"></i> Lưu kết quả
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}