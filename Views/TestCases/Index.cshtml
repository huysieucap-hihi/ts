@model IEnumerable<WebsiteQL_Testcase.Models.TestCase>

@{
    ViewData["Title"] = "Test Case Management";
    var testSuiteId = ViewData["TestSuiteId"] as Guid?;
    var testSuiteName = ViewData["TestSuiteName"] as string;
    var projectName = ViewData["ProjectName"] as string;

    // Lấy các giá trị đang lọc để hiển thị lại lên giao diện
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string;
    var currentPriority = ViewData["CurrentPriority"] as string;
}
<div class="khungvien">
<div id="testcase" class="page-content">

    <div class="page-header-flex">
        <div>
            <p class="sub-text">Manage and track test cases for: <strong>@testSuiteName</strong></p>
        </div>

        <div class="header-actions">
            <a asp-controller="TestSuites" asp-action="Index" asp-route-projectId="@ViewData["ProjectId"]" class="btn-outline-custom">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <a asp-action="Create" asp-route-testSuiteId="@testSuiteId" class="btn-primary-custom">
                <i class="fa-solid fa-plus"></i> Create Case
            </a>
        </div>
    </div>

    <form asp-action="Index" method="get" id="filterForm">

        <input type="hidden" name="testSuiteId" value="@testSuiteId" />

        <div class="filter-box">
            <div class="search-wrapper-flat">
                <button type="submit" style="border:none; background:none; cursor:pointer;">
                </button>

                <input type="text"
                       name="searchString"
                       value="@currentFilter"
                       placeholder="Search test cases..." />
            </div>

            <select class="select-flat" name="status" onchange="document.getElementById('filterForm').submit()">
                <option value="">All Statuses</option>
                <!option value="Draft" @(currentStatus == "Draft" ? "selected" : "")>Draft</!option>
                <!option value="Pass" @(currentStatus == "Pass" ? "selected" : "")>Pass</!option>
                <!option value="Fail" @(currentStatus == "Fail" ? "selected" : "")>Fail</!option>
            </select>

            <select class="select-flat" name="priority" onchange="document.getElementById('filterForm').submit()">
                <option value="">All Priorities</option>
                <!option value="High" @(currentPriority == "High" ? "selected" : "")>High</!option>
                <!option value="Medium" @(currentPriority == "Medium" ? "selected" : "")>Medium</!option>
                <!option value="Low" @(currentPriority == "Low" ? "selected" : "")>Low</!option>
            </select>
        </div>
    </form>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <p>No test cases found. Create one to get started.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-flat">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Create date</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="td-title">
                                <a asp-action="Details" asp-route-id="@item.Id">
                                    @item.Title
                                </a>
                                <span class="code-ref">#@item.Code</span>
                            </td>

                            <td>
                                <span class="badge @item.Priority.ToString().ToLower()">@item.Priority</span>
                            </td>

                            <td>
                                @if (item.LatestResult.HasValue)
                                {
                                    <span class="badge @item.LatestResult.ToString().ToLower()">@item.LatestResult</span>
                                }
                                else
                                {
                                    <span class="badge draft">Draft</span>
                                }
                            </td>

                            <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>

                            <td class="action text-right">
                                <a asp-controller="TestExecutions" asp-action="Create" asp-route-testCaseId="@item.Id" title="Run Test">
                                    <i class="fa-solid fa-play"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id" title="Delete" class="delete-icon">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
</div>