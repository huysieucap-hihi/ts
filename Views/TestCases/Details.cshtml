@model WebsiteQL_Testcase.Models.TestCase

@{
    ViewData["Title"] = $"Test Case: {Model.Code}";
}

@* BỌC TOÀN BỘ TRONG CONTAINER-CENTER *@
<div class="container-center">

    @* HEADER & ACTIONS *@
    <div class="page-header-container">
        <div class="page-title">
            <h2>@Model.Code: <strong>@Model.Title</strong></h2>
            <div style="font-size: 0.95rem; color: #666; margin-top: 8px;">
                Project: <strong>@Model.TestSuite.Project.Name</strong> | Suite: <strong>@Model.TestSuite.Name</strong>
            </div>
        </div>

        <div class="page-actions">
            <a asp-action="Index" asp-route-testSuiteId="@Model.TestSuiteId" class="btn-custom btn-back">
                ← Quay lại danh sách
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-custom btn-edit">
                Sửa Test Case
            </a>
        </div>
    </div>

    @* LAYOUT 2 CỘT (MAIN + SIDEBAR) *@
    <div class="details-layout">

        @* --- CỘT TRÁI: THÔNG TIN CHÍNH --- *@
        <div class="details-main">

            @* 1. Thông tin chung *@
            <div class="content-box">
                <h4 class="box-title">Thông tin chi tiết</h4>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="label">Priority:</span>
                        <span class="badge @Model.Priority.ToString().ToLower()">@Model.Priority</span>
                    </div>

                    <div class="info-item">
                        <span class="label">Status:</span>
                        <span class="badge @Model.Status.ToString().ToLower()">@Model.Status</span>
                    </div>

                    <div class="info-item">
                        <span class="label">Ngày tạo:</span>
                        <span class="value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="info-item">
                            <span class="label">Cập nhật:</span>
                            <span class="value">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="description-block">
                        <span class="label">Mô tả:</span>
                        <p>@Model.Description</p>
                    </div>
                }
            </div>

            @* 2. Test Steps *@
            <div class="content-box">
                <h4 class="box-title">Test Steps (@Model.Steps.Count bước)</h4>

                @if (Model.Steps.Any())
                {
                    <div class="table-container">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Action</th>
                                    <th>Expected Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var step in Model.Steps.OrderBy(s => s.StepNumber))
                                {
                                    <tr>
                                        <td style="font-weight: bold; text-align: center;">@step.StepNumber</td>
                                        <td>@step.Action</td>
                                        <td>@step.ExpectedResult</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-small">Chưa có Test Step nào.</div>
                }
            </div>

        </div>

        @* --- CỘT PHẢI: SIDEBAR HÀNH ĐỘNG & KẾT QUẢ --- *@
        <div class="details-sidebar">

            @* 1. Quick Actions *@
            <div class="content-box sidebar-box">
                <h4 class="box-title">Hành động</h4>
                <div class="action-list">
                    <a asp-controller="TestExecutions" asp-action="Create" asp-route-testCaseId="@Model.Id" class="btn-custom btn-run w-100">
                        ▶ Chạy Test
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-custom btn-edit w-100">
                        Sửa thông tin
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-custom btn-delete w-100">
                        Xóa Test Case
                    </a>
                </div>
            </div>

            @* 2. Latest Result *@
            <div class="content-box sidebar-box">
                <h4 class="box-title">Kết quả mới nhất</h4>
                <div style="text-align: center; padding: 10px;">
                    @if (Model.LatestResult.HasValue)
                    {
                        <div style="margin-bottom: 10px;">
                            <span class="badge @Model.LatestResult.ToString().ToLower()" style="font-size: 1.2rem; padding: 8px 16px;">
                                @Model.LatestResult
                            </span>
                        </div>
                        <small style="color: #666;">
                            @Model.Executions.FirstOrDefault()?.ExecutedAt.ToString("dd/MM HH:mm")
                        </small>
                    }
                    else
                    {
                        <span class="badge none" style="font-size: 1rem;">Chưa chạy</span>
                    }
                </div>
            </div>

            @* 3. Lịch sử gần đây *@
            @if (Model.Executions.Any())
            {
                <div class="content-box sidebar-box">
                    <h4 class="box-title">Lịch sử gần đây</h4>
                    <ul class="history-list">
                        @foreach (var execution in Model.Executions.OrderByDescending(e => e.ExecutedAt).Take(5))
                        {
                            <li class="history-item">
                                <span class="badge @execution.Result.ToString().ToLower()" style="font-size: 0.75rem;">
                                    @execution.Result
                                </span>
                                <span class="date">@execution.ExecutedAt.ToString("dd/MM")</span>
                            </li>
                        }
                    </ul>
                    <div style="text-align: center; margin-top: 10px;">
                        <a asp-controller="TestExecutions" asp-action="History" asp-route-testCaseId="@Model.Id" style="font-size: 0.9rem; text-decoration: none;">
                            Xem tất cả lịch sử →
                        </a>
                    </div>
                </div>
            }

        </div>
    </div>

</div>