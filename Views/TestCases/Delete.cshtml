@model WebsiteQL_Testcase.Models.TestCase

@{
    ViewData["Title"] = "Xóa Test Case";
}

@* BỌC TOÀN BỘ TRONG CONTAINER-CENTER *@
<div class="container-center">

    @* HEADER *@
    <div class="page-header-container">
        <div class="page-title">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    @* CẢNH BÁO (DANGER ALERT) *@
    <div class="alert-box danger">
        <span>
            <strong>Cảnh báo nguy hiểm!</strong> Hành động này sẽ xóa vĩnh viễn Test Case <strong>@Model.Code</strong> cùng tất cả các Steps và Lịch sử chạy test liên quan.
        </span>
    </div>

    @* NỘI DUNG CHI TIẾT *@
    <div class="content-box" style="max-width: 800px;">
        <h4 class="box-title">Thông tin xác nhận</h4>

        <div class="info-grid">
            <div class="info-item">
                <span class="label">Code:</span>
                <span class="value" style="font-weight: bold; color: #d9534f;">@Model.Code</span>
            </div>

            <div class="info-item">
                <span class="label">Title:</span>
                <span class="value">@Model.Title</span>
            </div>

            <div class="info-item">
                <span class="label">Priority:</span>
                <span class="badge @Model.Priority.ToString().ToLower()">@Model.Priority</span>
            </div>

            <div class="info-item">
                <span class="label">Status:</span>
                <span class="badge @Model.Status.ToString().ToLower()">@Model.Status</span>
            </div>

            <div class="info-item">
                <span class="label">Thuộc Suite:</span>
                <span class="value">@Model.TestSuite.Name</span>
            </div>

            <div class="info-item">
                <span class="label">Số lượng Steps:</span>
                <span class="value">@Model.Steps.Count bước</span>
            </div>
        </div>
    </div>

    @* FORM XÁC NHẬN *@
    <form asp-action="Delete" method="post" style="margin-top: 20px;">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TestSuiteId" />

        <div class="action-group">
            <button type="submit" class="btn-custom btn-delete" style="padding: 10px 20px; font-size: 1rem;">
                ✖ Xác nhận xóa vĩnh viễn
            </button>

            <a asp-action="Index" asp-route-testSuiteId="@Model.TestSuiteId" class="btn-custom btn-back" style="padding: 10px 20px; font-size: 1rem;">
                Hủy bỏ
            </a>
        </div>
    </form>

</div>