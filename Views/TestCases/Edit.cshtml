@model WebsiteQL_Testcase.Models.TestCase

@{
    ViewData["Title"] = "Sửa Test Case";
    var testSuiteName = Model.TestSuite?.Name;
    var projectName = Model.TestSuite?.Project?.Name;
}

<div class="page-header-container">
    <div class="page-title">
        <h2>Sửa Test Case: <strong>@Model.Code</strong></h2>
        <div style="font-size: 0.95rem; color: #666; margin-top: 8px;">
            Project: <strong>@projectName</strong> | Suite: <strong>@testSuiteName</strong>
        </div>
    </div>
</div>

@if (ViewBag.ModelStateErrors != null)
{
    <div class="alert-box danger" style="margin-bottom: 20px;">
        <div>
            <strong>Lỗi Validation:</strong>
            <ul style="margin: 5px 0 0 20px; padding: 0;">
                @foreach (var error in ViewBag.ModelStateErrors as Dictionary<string, string[]>)
                {
                    <li>@error.Key: @string.Join(", ", error.Value)</li>
                }
            </ul>
        </div>
    </div>
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="TestSuiteId" />
    <input type="hidden" asp-for="CreatedAt" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @* --- PHẦN 1: THÔNG TIN CHUNG --- *@
    <div class="content-box">
        <h4 class="box-title">Thông tin chung</h4>
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Code" class="form-label required">Mã Test Case</label>
                <input asp-for="Code" class="form-input" placeholder="VD: TC_LOGIN_001" required />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title" class="form-label required">Tiêu đề</label>
                <input asp-for="Title" class="form-input" placeholder="Nhập tiêu đề ngắn gọn" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Priority" class="form-label">Độ ưu tiên</label>
                <select asp-for="Priority" class="form-input">
                    <option value="1">Low</option>
                    <option value="2">Medium</option>
                    <option value="3">High</option>
                    <option value="4">Critical</option>
                </select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="form-label">Trạng thái</label>
                <select asp-for="Status" class="form-input">
                    <option value="1">Draft</option>
                    <option value="2">Active</option>
                    <option value="3">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group" style="margin-top: 15px;">
            <label asp-for="Description" class="form-label">Mô tả chi tiết</label>
            <textarea asp-for="Description" class="form-input" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    @* --- PHẦN 2: TEST STEPS --- *@
    <div class="content-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
            <h4 class="box-title" style="margin: 0; border: none;">Test Steps</h4>

            @* ID btnAddStep dùng để JS bắt sự kiện *@
            <button type="button" id="btnAddStep" class="btn-custom btn-create" style="font-size: 0.9rem; padding: 6px 12px;">
                + Thêm Step
            </button>
        </div>

        @* Data-step-count: Truyền số lượng step hiện tại sang JS *@
        <div id="steps-container" data-step-count="@(Model.Steps?.Count ?? 0)">

            @if (Model.Steps != null && Model.Steps.Any())
            {
                var sortedSteps = Model.Steps.OrderBy(s => s.StepNumber).ToList();
                for (int i = 0; i < sortedSteps.Count; i++)
                {
                    <div class="step-item" data-step="@(i + 1)">
                        <div class="step-header">
                            <span class="step-badge">Step @(i + 1)</span>
                            @* Class btn-close-step dùng để JS bắt sự kiện xóa *@
                            <button type="button" class="btn-close-step" title="Xóa step này">×</button>
                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">Hành động (Action)</label>
                                <textarea name="Actions[@i]" class="form-input" rows="2" required>@sortedSteps[i].Action</textarea>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Kết quả mong đợi (Expected)</label>
                                <textarea name="ExpectedResults[@i]" class="form-input" rows="2">@sortedSteps[i].ExpectedResult</textarea>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="padding: 20px; text-align: center; color: #888; font-style: italic;" id="no-steps-msg">
                    Chưa có bước kiểm thử nào. Bấm "Thêm Step" để bắt đầu.
                </div>
            }
        </div>
    </div>

    @* BUTTONS *@
    <div class="action-group" style="margin-top: 20px;">
        <button type="submit" class="btn-custom btn-create" style="padding: 10px 25px; font-size: 1rem;">
            Lưu Thay Đổi
        </button>
        <a asp-action="Index" asp-route-testSuiteId="@Model.TestSuiteId" class="btn-custom btn-back" style="padding: 10px 25px; font-size: 1rem;">
            Hủy bỏ
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @* Không còn thẻ <script> ở đây nữa *@
}