<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Test Case Management</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebsiteQL_Testcase.styles.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8f9fa;
            color: #212529;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            transition: background-color 0.3s, color 0.3s;
        }

        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 250px;
            z-index: 1000;
            padding: 0;
            background-color: #343a40;
            box-shadow: 2px 0 10px rgba(0,0,0,0.15);
            overflow-y: auto;
        }

        .sidebar-header {
            padding: 20px;
            background-color: #2c3136;
            text-align: center;
            border-bottom: 1px solid #495057;
        }

            .sidebar-header h4 {
                color: #fff;
                margin: 0;
                font-weight: 600;
            }

        .sidebar .nav-link {
            color: #adb5bd;
            padding: 12px 20px;
            font-size: 15px;
            transition: all 0.3s;
        }

            .sidebar .nav-link:hover,
            .sidebar .nav-link.active {
                color: #fff;
                background-color: #495057;
            }

            .sidebar .nav-link i {
                width: 24px;
                text-align: center;
                margin-right: 10px;
            }

        .main-content {
            margin-left: 250px;
            padding: 20px;
            min-height: 100vh;
            transition: margin-left 0.3s;
        }

        .page-header {
            background-color: #007bff;
            color: white;
            padding: 20px 30px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 4px 12px rgba(0,123,255,0.15);
        }

        footer {
            margin-left: 250px;
            background-color: #f8f9fa;
            padding: 20px 0;
            font-size: 14px;
            border-top: 1px solid #dee2e6;
            transition: margin-left 0.3s;
        }

        @@media (max-width: 992px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main-content, footer {
                margin-left: 0;
            }
        }

        /* DARK MODE */
        body.dark-mode {
            background-color: #121212;
            color: #e0e0e0;
        }

            body.dark-mode .sidebar {
                background-color: #1e1e1e;
            }

            body.dark-mode .card {
                background-color: #1e1e1e;
                color: #e0e0e0;
                border-color: #333;
            }

            body.dark-mode .page-header {
                background-color: #0d6efd;
            }

            body.dark-mode .text-muted {
                color: #a0a0a0 !important;
            }

            body.dark-mode .btn-outline-light {
                color: #e0e0e0;
                border-color: #444;
            }

            body.dark-mode .dropdown-menu {
                background-color: #222;
                border-color: #444;
            }

            body.dark-mode .dropdown-item {
                color: #e0e0e0;
            }

                body.dark-mode .dropdown-item:hover {
                    background-color: #333;
                }

            /* CẢI THIỆN CHỮ TRONG BẢNG DARK MODE */
            body.dark-mode .table {
                color: #e9ecef;
                background-color: #1e1e1e;
            }

                body.dark-mode .table th {
                    color: #fff;
                    background-color: #343a40;
                    border-color: #495057;
                }

                body.dark-mode .table td {
                    color: #dee2e6;
                    border-color: #495057;
                }

            body.dark-mode .table-striped tbody tr:nth-of-type(odd) {
                background-color: #242424;
            }

            body.dark-mode .table-hover tbody tr:hover {
                background-color: #333;
                color: #fff;
            }
            /* FIX LIST GROUP TRONG DARK MODE */
            body.dark-mode .list-group-item {
                background-color: #1e1e1e;
                color: #e0e0e0;
                border-color: #333;
            }

                body.dark-mode .list-group-item:hover {
                    background-color: #2a2a2a;
                }

                body.dark-mode .list-group-item small,
                body.dark-mode .list-group-item .text-muted {
                    color: #a0a0a0 !important;
                }
            /* FIX INPUT / LOGIN FORM DARK MODE */
            body.dark-mode .form-control {
                background-color: #1e1e1e;
                color: #e0e0e0;
                border-color: #444;
            }

                body.dark-mode .form-control::placeholder {
                    color: #9e9e9e;
                }

                body.dark-mode .form-control:focus {
                    background-color: #1e1e1e;
                    color: #ffffff;
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.25);
                }
            /* ===== MODAL ===== */
            body.dark-mode .modal-content,
            body.dark-mode .modal-header,
            body.dark-mode .modal-body,
            body.dark-mode .modal-footer {
                background-color: #1e1e1e;
                color: #e0e0e0;
                border-color: #333;
            }

            /* ===== FORM ===== */
            body.dark-mode input,
            body.dark-mode textarea,
            body.dark-mode select,
            body.dark-mode .form-control,
            body.dark-mode .form-select {
                background-color: #1e1e1e;
                color: #e0e0e0;
                border-color: #444;
            }

            body.dark-mode option {
                background-color: #1e1e1e;
                color: #e0e0e0;
            }

            /* ===== FOOTER ===== */
            body.dark-mode footer {
                background-color: #121212;
                border-top: 1px solid #333;
            }
        /* ===== PASSWORD TOGGLE (LOGIN) ===== */
        .password-toggle {
            position: absolute;
            top: 50%;
            right: 16px;
            transform: translateY(-50%);
            cursor: pointer;
            z-index: 10;
        }

        /* Light mode */
        body.light-mode .password-toggle i {
            color: #212529;
        }

        /* Dark mode */
        body.dark-mode .password-toggle i {
            color: #e0e0e0;
        }

        .password-toggle:hover i {
            color: #0d6efd;
        }

        /* FIX FLOATING LABEL DARK MODE */
        body.dark-mode .form-floating > label {
            color: #aaa;
        }

        body.dark-mode .form-control:focus + label,
        body.dark-mode .form-control:not(:placeholder-shown) + label {
            color: #0d6efd;
        }
        /* ===== ẨN ICON HIỆN PASSWORD CỦA BROWSER ===== */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
        }

        /* Chrome / Edge */
        input[type="password"]::-webkit-credentials-auto-fill-button {
            visibility: hidden;
            display: none !important;
        }
    </style>
</head>
<body>
    @inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
    @using System.Globalization
    @using Microsoft.AspNetCore.Localization

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h4>Test Case Management</h4>
        </div>

        <nav class="nav flex-column mt-3">
            <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Dashboard") ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i> @Localizer["Dashboard"]
            </a>
            <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Projects") ? "active" : "")"
               asp-controller="Projects" asp-action="Index">
                <i class="bi bi-folder-fill"></i> @Localizer["Projects"]
            </a>

            <!-- Dropdown Test Suites -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle @(Context.Request.Path.StartsWithSegments("/TestSuites") ? "active" : "")"
                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-collection-fill"></i> @Localizer["Test Suites"]
                </a>
                <ul class="dropdown-menu dropdown-menu-dark">
                    @await Component.InvokeAsync("ProjectListForSidebar")
                </ul>
            </li>

            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle @(Context.Request.Path.StartsWithSegments("/TestCases") ? "active" : "")"
                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-journal-text"></i> @Localizer["Test Cases"]
                </a>
                <ul class="dropdown-menu dropdown-menu-dark">
                    @await Component.InvokeAsync("TestSuiteListForSidebar")
                </ul>
            </li>

            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle @(Context.Request.Path.StartsWithSegments("/TestExecutions") ? "active" : "")"
                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-play-circle-fill"></i> @Localizer["Executions"]
                </a>
                <ul class="dropdown-menu dropdown-menu-dark">
                    @await Component.InvokeAsync("TestCaseListForSidebar")
                </ul>
            </li>

            <hr class="border-secondary mx-3 my-4">

          

            <!-- Dark/Light Mode Toggle -->
            <div class="px-3 mb-3">
                <button id="theme-toggle" class="btn btn-outline-light btn-sm w-100 text-start">
                    <i id="theme-icon" class="bi bi-moon-stars-fill me-2"></i>
                    <span id="theme-text">Chế độ tối</span>
                </button>
            </div>

            <!-- Login Partial -->
            <partial name="_LoginPartial" />
        </nav>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <header class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="bi bi-gear-wide-connected me-2"></i>
                    @ViewData["Title"]
                </h3>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-white">
                        <i class="bi bi-person-circle me-2"></i>
                        @User.Identity.Name
                    </span>
                }
            </div>
        </header>

        <main>
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container text-center text-muted">
            &copy; 2025 - <strong>Test Case Management System</strong> • All rights reserved
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Dark/Light Mode Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('theme-toggle');
            const icon = document.getElementById('theme-icon');
            const text = document.getElementById('theme-text');

            // Load theme từ localStorage
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.body.classList.add(savedTheme + '-mode');
            updateUI(savedTheme);

            // Click để đổi theme
            toggleBtn.addEventListener('click', () => {
                const currentTheme = document.body.classList.contains('dark-mode') ? 'light' : 'dark';
                document.body.classList.remove('light-mode', 'dark-mode');
                document.body.classList.add(currentTheme + '-mode');
                localStorage.setItem('theme', currentTheme);
                updateUI(currentTheme);
            });

            function updateUI(theme) {
                if (theme === 'dark') {
                    icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                    text.textContent = 'Chế độ sáng';
                } else {
                    icon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                    text.textContent = 'Chế độ tối';
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>