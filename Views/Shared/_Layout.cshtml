<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <title>@ViewData["Title"] - Test Case Management</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function() {
            try {
                // Kiểm tra localStorage
                var localTheme = localStorage.getItem('theme');
                // Kiểm tra cài đặt hệ thống (Windows/Mac đang để dark hay light)
                var supportDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;

                // Nếu đã lưu 'dark' HOẶC (chưa lưu gì cả NHƯNG máy tính đang để dark mode)
                if (localTheme === 'dark' || (!localTheme && supportDarkMode)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) {}
        })();
    </script>

    <style>
        /* Đảm bảo khi html có data-theme="dark", nền đổi màu ngay lập tức */
        [data-theme="dark"] {
            background-color: #1a1a1a !important; /* Thay mã màu này trùng với màu nền tối trong CSS của bạn */
            color: #e0e0e0;
        }

            [data-theme="dark"] body {
                background-color: #1a1a1a !important;
                color: #e0e0e0;
            }
    </style>
</head>
<body>

    @* ===== HEADER CHO NGƯỜI CHƯA LOGIN ===== *@
    @if (User.Identity?.IsAuthenticated != true)
    {
        <header class="public-header">
            <div class="public-header-inner">
                <span class="logo">Test Case Management</span>

                <div class="auth-actions">
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">
                        Đăng nhập
                    </a>
                    <a asp-area="Identity" asp-page="/Account/login" class="btn btn-outline">
                        Đăng ký
                    </a>
                </div>
            </div>
        </header>
    }

    <div class="app-layout">

        @* ===== SIDEBAR ===== *@
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="sidebar">
                <div class="sidebar-header">
                    <h4>Test Case Management</h4>
                </div>

                <nav class="sidebar-nav">
                    <a class="sidebar-item @(Context.Request.Path.StartsWithSegments("/Dashboard") || Context.Request.Path == "/" || Context.Request.Path.StartsWithSegments("/Home") ? "active" : "")"
                       asp-controller="Dashboard" asp-action="Index">
                        Dashboard
                    </a>

                    <a class="sidebar-item @(Context.Request.Path.StartsWithSegments("/Projects") ? "active" : "")"
                       asp-controller="Projects" asp-action="Index">
                        Projects
                    </a>

                    <div class="sidebar-dropdown">
                        <button type="button" class="sidebar-item dropdown-toggle">
                            Test Suites
                        </button>
                        <div class="dropdown-menu">
                            @await Component.InvokeAsync("ProjectListForSidebar")
                        </div>
                    </div>

                    <div class="sidebar-dropdown">
                        <button type="button" class="sidebar-item dropdown-toggle">
                            Test Cases
                        </button>
                        <div class="dropdown-menu">
                            @await Component.InvokeAsync("TestSuiteListForSidebar")
                        </div>
                    </div>

                    <div class="sidebar-dropdown">
                        <button type="button" class="sidebar-item dropdown-toggle">
                            Executions
                        </button>
                        <div class="dropdown-menu">
                            @await Component.InvokeAsync("TestCaseListForSidebar")
                        </div>
                    </div>

                    @* ĐÃ XÓA NÚT DARK MODE Ở ĐÂY ĐỂ CHUYỂN LÊN HEADER *@
                </nav>
            </aside>
        }

        @* ===== MAIN CONTENT ===== *@
        <div class="main-content">
            <header class="page-header">
                <h3>@ViewData["Title"]</h3>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div style="display: flex; align-items: center; gap: 12px;">

                        <button id="theme-toggle" class="btn btn-outline" style="padding: 5px 10px;" title="Chuyển chế độ Sáng/Tối">
                            <span id="theme-icon">🌙</span>
                        </button>

                        <span style="font-weight: 600; font-size: 14px;">
                            @User.Identity.Name
                        </span>

                        <a asp-area="Identity" asp-page="/Account/Manage/Index"
                           class="btn btn-outline"
                           style="font-size: 13px; padding: 5px 12px; border: 1px solid #ccc;">
                            Quản lý
                        </a>

                        <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger"
                                    style="font-size: 13px; padding: 5px 12px;">
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                }
            </header>

            <main>
                @RenderBody()
            </main>

            <footer class="footer">
                Web được sửa bởi Quang Huy và GPT and Gemini
                ZALO: 0869699251
                - © 2024 Test Case Management System
            </footer>
        </div>

    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>