<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Test Case Management</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script>
        (function() {
            try {
                var localTheme = localStorage.getItem('theme');
                var supportDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (localTheme === 'dark' || (!localTheme && supportDarkMode)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) {}
        })();
    </script>
</head>
<body>

    @* ===== HEADER (Cho người chưa đăng nhập) ===== *@
    @if (User.Identity?.IsAuthenticated != true)
    {
        <header class="public-header">
            <div class="public-header-inner">
                <span class="logo">Test Case Management</span>
                <div class="auth-actions">
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn-auth primary">Đăng nhập</a>
                    <a asp-area="Identity" asp-page="/Account/login" class="btn-auth outline">Đăng ký</a>
                </div>
            </div>
        </header>
    }

    <div class="app-container">

        @* ===== SIDEBAR ===== *@
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="sidebar">
                <div class="sidebar-logo">
                    <i class="fa-solid fa-house-chimney"></i>
                </div>

                <nav class="sidebar-menu">
                    <form asp-controller="Dashboard" asp-action="Index" method="get" class="nav-form">
                        <button type="submit" class="menu-btn @(Context.Request.Path.StartsWithSegments("/Dashboard") || Context.Request.Path == "/" ? "active" : "")">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span>Dashboard</span>
                        </button>
                    </form>

                    <form asp-controller="Projects" asp-action="Index" method="get" class="nav-form">
                        <button type="submit" class="menu-btn @(Context.Request.Path.StartsWithSegments("/Projects") ? "active" : "")">
                            <i class="fa-solid fa-folder-open"></i>
                            <span>Projects</span>
                        </button>
                    </form>

                    <div class="nav-dropdown">
                        <button type="button" class="menu-btn dropdown-toggle" onclick="toggleDropdown(this)">
                            <i class="fa-solid fa-layer-group"></i>
                            <span>Test Suites</span>
                            <i class="fa-solid fa-chevron-down arrow-icon"></i>
                        </button>
                        <div class="dropdown-content">
                            @await Component.InvokeAsync("ProjectListForSidebar")
                        </div>
                    </div>

                    <div class="nav-dropdown">
                        <button type="button" class="menu-btn dropdown-toggle" onclick="toggleDropdown(this)">
                            <i class="fa-solid fa-list-check"></i>
                            <span>Test Cases</span>
                            <i class="fa-solid fa-chevron-down arrow-icon"></i>
                        </button>
                        <div class="dropdown-content">
                            @await Component.InvokeAsync("TestSuiteListForSidebar")
                        </div>
                    </div>

                    <div class="nav-dropdown">
                        <button type="button" class="menu-btn dropdown-toggle" onclick="toggleDropdown(this)">
                            <i class="fa-solid fa-play"></i>
                            <span>Executions</span>
                            <i class="fa-solid fa-chevron-down arrow-icon"></i>
                        </button>
                        <div class="dropdown-content">
                            @await Component.InvokeAsync("TestCaseListForSidebar")
                        </div>
                    </div>

                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="nav-link-wrapper">
                        <div class="menu-btn">
                            <i class="fa-solid fa-user-gear"></i>
                            <span>User Settings</span>
                        </div>
                    </a>
                </nav>
            </aside>
        }

        @* ===== MAIN CONTENT ===== *@
        <main class="main-content">
            <header class="top-header">
                <h1 class="page-title">@ViewData["Title"]</h1>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-controls">

                        <span class="user-name">@User.Identity.Name</span>

                        <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                            <button type="submit" class="btn-logout">
                                <i class="fa-solid fa-right-from-bracket"></i> Thoát
                            </button>
                        </form>
                    </div>
                }
            </header>

            <div class="content-body">
                @RenderBody()
            </div>

            <footer class="footer">
               © 2024
            </footer>
        </main>
    </div>

    <script>
        // Xử lý mở/đóng dropdown
        function toggleDropdown(btn) {
            var content = btn.nextElementSibling;
            content.classList.toggle("show");
            btn.classList.toggle("open");
        }
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>