@model IEnumerable<dynamic>

@if (!Model.Any())
{
    <li class="dropdown-item text-muted disabled">
        Chưa có Project nào
    </li>
}
else
{
    @foreach (var project in Model)
    {
        <li>
            <a class="dropdown-item d-flex justify-content-between align-items-center"
               asp-controller="TestSuites"
               asp-action="Index"
               asp-route-projectId="@project.Id">
                <span>@project.Name</span>
                <span class="badge bg-secondary rounded-pill">@project.TestSuiteCount suites</span>
            </a>
        </li>
    }

    <li><hr class="dropdown-divider"></li>
    <li>
        <a class="dropdown-item text-center fw-bold" asp-controller="Projects" asp-action="Index">
            Xem tất cả Projects →
        </a>
    </li>
}