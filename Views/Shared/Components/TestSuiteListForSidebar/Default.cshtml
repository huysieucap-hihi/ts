@model IEnumerable<dynamic>

@if (!Model.Any())
{
    <li class="dropdown-item text-muted disabled">
        Chưa có Test Suite nào
    </li>
}
else
{
    @foreach (var suite in Model)
    {
        <li>
            <a class="dropdown-item d-flex justify-content-between align-items-center"
               asp-controller="TestCases"
               asp-action="Index"
               asp-route-testSuiteId="@suite.Id">
                <span>@suite.ProjectName - @suite.Name</span>
                <span class="badge bg-secondary rounded-pill">@suite.TestCaseCount cases</span>
            </a>
        </li>
    }

    <li><hr class="dropdown-divider"></li>
    <li>
        <a class="dropdown-item text-center fw-bold" asp-controller="Projects" asp-action="Index">
            Xem tất cả Projects →
        </a>
    </li>
}